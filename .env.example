# Copy to .env and fill in, or export the variables directly.
# This file documents the variables; .env itself is gitignored.

# Stage 07 (LLM-based cluster validation). Required to run the protocols.
DEEPSEEK_API_KEY=sk-your-key-here

# Stages 01-02 (OpenAlex). Both optional: the mail address puts requests in
# OpenAlex's faster "polite pool", the key raises rate limits if you have one.
OPENALEX_MAILTO=you@example.org
OPENALEX_API_KEY=
