# ---------------------------------------------------------------
# LaTeX build artifacts (all regenerable from the .tex sources)
#
# Scoped to the two directories that hold LaTeX documents. A blanket `*.log`
# would also swallow the run logs in results/, which are part of the archived
# record.
# ---------------------------------------------------------------
paper/*.aux
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.lof
paper/*.log
paper/*.lot
paper/*.out
paper/*.run.xml
paper/*.synctex.gz
paper/*.toc
supplementary/*.aux
supplementary/*.bcf
supplementary/*.blg
supplementary/*.fdb_latexmk
supplementary/*.fls
supplementary/*.lof
supplementary/*.log
supplementary/*.lot
supplementary/*.out
supplementary/*.run.xml
supplementary/*.synctex.gz
supplementary/*.toc

# Lab scaffolding left behind by long background runs.
results/**/.*.pid
results/**/.chain_*.log
paper/*.bbl
supplementary/*.bbl
